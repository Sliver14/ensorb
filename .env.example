# ==============================================================================
# ENSORB WEDDING PORTAL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL / Vercel Postgres)
# ------------------------------------------------------------------------------
# Paste your Neon / PostgreSQL connection string below (with ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative aliases supported by lib/db.ts:
# POSTGRES_URL=
# NEON_DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
# Admin portal security PIN
ADMIN_PIN=ensorb2026

# Canonical website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. EMAIL DISPATCH SERVICE (Resend API)
# ------------------------------------------------------------------------------
# Resend API key for automated RSVP digital passes & invitation notifications
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Ngozi & Sorbari Wedding <invites@ensorb.com>

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA ASSETS (Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
